# Supabase Postgres connection string.
# Locally: the session pooler (port 5432) -- run migrations over this.
# On Vercel: the transaction pooler (port 6543), built for serverless connections.
DATABASE_URL=

# Optional. IANA timezone used to resolve "last week", "in March", etc.
# Defaults to the system timezone if unset.
MEMORY_TZ=Asia/Calcutta

# ── Gemini: answers and embeddings ────────────────────────────────────────
# Required. The same key is used for embeddings (gemini-embedding-001, 768 dims)
# unless EMBEDDING_API_KEY is set.
#
# Google Gemini (has an OpenAI-compatible endpoint, so no client change needed):
#   key: https://aistudio.google.com/apikey
ANSWER_API_KEY=
ANSWER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# A moving alias on purpose: pinned versions get retired and break the app.
# "lite" also matters: gemini-flash-latest resolves to a model capped at
# 20 requests/day on the free tier, which a few questions will exhaust.
ANSWER_MODEL=gemini-flash-lite-latest

# ── Auth (Supabase) ───────────────────────────────────────────────────────
# Both are safe in client code: the publishable key grants nothing on its own,
# because every table is protected by row level security.
NEXT_PUBLIC_SUPABASE_URL=https://jaakijfmbmljzpixxbsq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_i4rJ0msZbKa2NM7cYrXUuA_SoC1FrNh

# Local installs only. Enables indexing a folder from your own filesystem;
# on a hosted deployment that would read the container, so leave it unset.
CORTEX_LOCAL=true
