# Supabase Postgres connection string.
# IMPORTANT: use the session pooler (port 5432) or the direct connection.
# The transaction pooler (port 6543) breaks prepared statements and will fail migrations.
DATABASE_URL=

# Optional. IANA timezone used to resolve "last week", "in March", etc.
# Defaults to the system timezone if unset.
MEMORY_TZ=Asia/Calcutta

# No API keys are required. Embeddings run locally via onnxruntime.

# Optional: a free API key enables written answers in the chat.
# Without it, retrieval still works and matching excerpts are listed.
# OpenRouter: https://openrouter.ai/keys   (free models available)
ANSWER_API_KEY=
# ANSWER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# ANSWER_BASE_URL=https://openrouter.ai/api/v1
