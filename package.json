{
  "name": "cortex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "ingest": "tsx --env-file-if-exists=.env src/cli/ingest.ts",
    "search": "tsx --env-file-if-exists=.env src/cli/search.ts",
    "seed:fixtures": "tsx --env-file-if-exists=.env src/cli/seed.ts",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "test:golden": "tsx --env-file-if-exists=.env src/cli/golden.ts",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "commander": "^15.0.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "0.7.5",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}
